<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="1000.0" styleClass="fondo-panel" stylesheets="@../../css/gestionarUsuarios/estilosCssGestionarRolesDeUsuario.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarUsuarios.GestionarRolesDeUsuarioControlador">

    <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="panel-encabezado">
        <Label styleClass="titulo-principal" text="Gestionar Roles del Usuario" />
        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <Label styleClass="label-id-texto" text="Usuario seleccionado:" />
            <Label fx:id="lblNombreUsuario" styleClass="label-id-valor" text="Cargando Usuario ..." />
        </HBox>
    </VBox>

    <HBox spacing="20.0" styleClass="panel-formulario" VBox.vgrow="ALWAYS">

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label styleClass="label-tabla-titulo" text="✅ Roles Asignados" />
            <TableView fx:id="tablaRolesActuales" prefHeight="300.0" prefWidth="386.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdActual" prefWidth="60.0" text="ID" />
                    <TableColumn fx:id="colNombreActual" prefWidth="288.0000190734863" text="NOMBRE DEL ROL" />
                    <TableColumn fx:id="colActivoActual" prefWidth="112.79998779296875" text="ACTIVO" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quitarRol" prefHeight="40.0" styleClass="btn-quitar" text="Quitar Rol Seleccionado ➡" />
        </VBox>

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label styleClass="label-tabla-titulo" text="➕ Roles Disponibles" />
            <TableView fx:id="tablaRolesDisponibles" prefHeight="297.0" prefWidth="409.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdDisponible" prefWidth="60.0" text="ID" />
                    <TableColumn fx:id="colNombreDisponible" prefWidth="301.59998321533203" text="NOMBRE DEL ROL" />
                    <TableColumn fx:id="colActivoDisponible" prefWidth="123.199951171875" text="ACTIVO" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#anadirRol" prefHeight="40.0" styleClass="btn-anadir" text="⬅ Añadir Rol Seleccionado" />
        </VBox>

    </HBox>

    <HBox alignment="CENTER_RIGHT" prefHeight="80.0" prefWidth="930.0" spacing="15.0" styleClass="panel-botones">
        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCambios" prefHeight="45.0" prefWidth="170.0" styleClass="btn-guardar" text="Guardar Cambios" />
        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cerrarVentana" prefHeight="45.0" prefWidth="130.0" styleClass="btn-cancelar" text="Cancelar" />
    </HBox>

</VBox>
