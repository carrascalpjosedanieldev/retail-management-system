<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="420.0" styleClass="fondo-panel" stylesheets="@../../css/login/estilosCssCambioContrasena.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.login.CambioContrasenaControlador">

    <VBox alignment="CENTER" spacing="10.0" styleClass="panel-encabezado">
        <Label styleClass="icono-candado" text="🔐" />
        <HBox alignment="CENTER" prefHeight="24.0" prefWidth="302.0">
            <Label styleClass="titulo-principal" text="¡Bienvenido, "/>
            <Label fx:id="lblNombreUsuario" styleClass="titulo-principal" text="Cargando Nombre ..."/>
            <Label styleClass="titulo-principal" text=" !"/>
        </HBox>
    </VBox>

    <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="panel-formulario" VBox.vgrow="ALWAYS">

        <VBox alignment="CENTER" styleClass="panel-advertencia">
            <Label styleClass="texto-advertencia" text="Tu contraseña actual es temporal." wrapText="true" />
            <Label styleClass="texto-advertencia" text="Por tu seguridad, escribe una nueva contraseña." wrapText="true" />
        </VBox>

        <VBox spacing="15.0" VBox.vgrow="ALWAYS">

            <VBox spacing="5.0">
                <Label styleClass="label-formulario" text="Nueva Contraseña:" />
                <StackPane alignment="CENTER_RIGHT">
                    <TextField fx:id="txtNuevaVis" promptText="Escribe tu nueva contraseña" styleClass="campo-contrasena" visible="false" />
                    <PasswordField fx:id="txtNuevaOculta" promptText="Escribe tu nueva contraseña" styleClass="campo-contrasena" />
                    <Button fx:id="btnVerNueva" mnemonicParsing="false" onAction="#alternarVisibilidadNueva" styleClass="btn-ver-contrasena" text="👁" />
                </StackPane>
            </VBox>

            <VBox spacing="5.0">
                <Label styleClass="label-formulario" text="Confirmar Contraseña:" />
                <StackPane alignment="CENTER_RIGHT">
                    <TextField fx:id="txtConfirmarVis" promptText="Repite la nueva contraseña" styleClass="campo-contrasena" visible="false" />
                    <PasswordField fx:id="txtConfirmarOculta" promptText="Repite la nueva contraseña" styleClass="campo-contrasena" />
                    <Button fx:id="btnVerConfirmar" mnemonicParsing="false" onAction="#alternarVisibilidadConfirmar" styleClass="btn-ver-contrasena" text="👁" />
                </StackPane>
            </VBox>

        </VBox>
    </VBox>

    <VBox alignment="CENTER" styleClass="panel-botones">
        <Button fx:id="btnRestablecer" defaultButton="true" mnemonicParsing="false" onAction="#restablecerContrasena" prefHeight="45.0" styleClass="btn-restablecer" text="Restablecer Contraseña" />
    </VBox>

</VBox>
