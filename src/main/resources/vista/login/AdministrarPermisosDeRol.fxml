<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../../css/login/estilosCssAdmisitrarPermisosDeRol.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RetailManagementSystem.vista.controladores.login.AdministrarPermisosDeRolControlador">

    <VBox style="-fx-padding: 40; -fx-spacing: 20;" HBox.hgrow="ALWAYS">

        <VBox style="-fx-spacing: 5;">
            <Label styleClass="titulo-principal" text="Permisos Asignados"/>
            <HBox alignment="CENTER_LEFT" style="-fx-spacing: 10;">
                <Label styleClass="subtitulo" text="Rol Seleccionado:"/>
                <Label fx:id="lblNombreRol" styleClass="badge-rol" text="Cargando Rol..."/>
            </HBox>
        </VBox>

        <!-- Tabla de Permisos del Rol -->
        <TableView fx:id="tablaPermisosRol" styleClass="tabla-personalizada" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="300.0" text="NOMBRE DEL PERMISO" />
                <TableColumn fx:id="colModulo" prefWidth="200.0" text="MÓDULO" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="Este rol no tiene permisos asignados aún." />
            </placeholder>
        </TableView>
    </VBox>

    <!-- PANEL DERECHO: Acciones -->
    <VBox alignment="TOP_CENTER" prefWidth="320.0" styleClass="panel-acciones">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-padding: 0 0 20 0;" text="Acciones del Rol"/>

        <Button onAction="#anadirPermiso" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-anadir" text="➕ Añadir Permiso" />
        <Button onAction="#eliminarPermiso" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-eliminar" text="❌ Quitar Permiso" />

        <!-- Espaciador flexible para empujar el botón de volver al fondo -->
        <Region VBox.vgrow="ALWAYS"/>

        <Button onAction="#volverARoles" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-volver" text="⬅ Volver a Roles" />
    </VBox>

</HBox>
