<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" stylesheets="@../css/estilosCssProductos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.GestionProductosControlador">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestión de Productos" />
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#volverAlPanel" styleClass="btn-accion, btn-secundario" text="Volver a Inventarios" />
    </HBox>

    <TabPane fx:id="tabPaneProductos" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Vista General">
            <fx:include fx:id="tabGeneral" source="tabGeneralProductos.fxml" />
        </Tab>

        <Tab text="👕 Ropa">
            <fx:include fx:id="tabRopa" source="tabRopa.fxml"/>
        </Tab>

        <Tab text="🍎 Perecederos">
            <fx:include source="tabPerecederos.fxml" />
        </Tab>
    </TabPane>
</VBox>
