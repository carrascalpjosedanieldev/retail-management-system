<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" styleClass="fondo-panel" stylesheets="@../../../../../css/gestionarTienda/gestionarInventarios/gestionarProductos/tabGeneral/estilosCssMoverProductoAOtroInventario.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarInventarios.gestionarProductos.tabGeneral.MoverProductoAOtroInventarioControlador">
    <VBox alignment="CENTER_LEFT" styleClass="panel-encabezado">
        <HBox>
            <Label styleClass="titulo-principal" text="Mover: " />
            <Label fx:id="lblNombreProducto" styleClass="titulo-principal" text="..." />
        </HBox>
    </VBox>


    <VBox spacing="15.0" styleClass="panel-formulario" VBox.vgrow="ALWAYS">
        <Label fx:id="lblInfo" styleClass="label-advertencia" text="Se moverá la referencia completa y sus ... unidades disponibles." wrapText="true" />

        <Label styleClass="label-formulario" text="Seleccione el Inventario de Destino:">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>

        <ComboBox fx:id="comboInventarios" prefWidth="250.0" promptText="Elegir Inventario..." styleClass="combo-box-personalizado" />

    </VBox>


    <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="panel-botones">
        <Button mnemonicParsing="false" onAction="#moverProducto" prefHeight="43.0" prefWidth="146.0" styleClass="btn-mover" text="Mover Producto" />
        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefWidth="110.0" styleClass="btn-cancelar" text="Cancelar" />
    </HBox>

</VBox>
