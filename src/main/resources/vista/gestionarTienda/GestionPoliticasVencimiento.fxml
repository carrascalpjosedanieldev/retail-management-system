<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../../css/gestionarTienda/estilosCssPoliticasVencimiento.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.GestionPoliticasVencimientoControlador">

    <VBox style="-fx-padding: 40; -fx-spacing: 20;" styleClass="label-busqueda" HBox.hgrow="ALWAYS">
        <Label styleClass="titulo-principal" text="Gestión de Politicas de Vencimiento" />

        <HBox alignment="CENTER_LEFT" style="-fx-spacing: 15;">
            <Label style="-fx-font-size: 18px;" text="🔍" />
            <Label prefHeight="26.0" prefWidth="66.0" text="Buscar:" />
            <TextField fx:id="txtBuscar" prefWidth="400.0" promptText="Buscar por ID o Nombre de la Politica V..." styleClass="campo-busqueda" />
        </HBox>

        <TableView fx:id="tablaPoliticasVencimiento" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="318.3999938964844" text="NOMBRE DE LA POLITICA DE VENCIMIENTO" />
            <TableColumn fx:id="colDiasUmbral" prefWidth="148.79995727539062" text="DIAS UMBRAL" />
                <TableColumn fx:id="colPorcentaje" prefWidth="165.599853515625" text="PORCENTAJE (%)" />
                <TableColumn fx:id="colEstado" prefWidth="161.60009765625" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox alignment="TOP_CENTER" prefWidth="300.0" styleClass="panel-acciones">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-padding: 0 0 20 0;" text="Acciones" />

        <Button onAction="#abrirFormularioNuevo" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-nuevo" text="➕ Nueva Politica V..." />
        <Button onAction="#abrirFormularioEdicion" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion" text="✏️ Modificar Seleccionado" />
        <Button onAction="#cambiarEstadoPoliticaV" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion" text="🔄 Activar / Desactivar" />

        <VBox VBox.vgrow="ALWAYS" />

        <Button onAction="#volverAlPanel" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion" text="⬅️ Volver al Panel" />
    </VBox>

</HBox>
