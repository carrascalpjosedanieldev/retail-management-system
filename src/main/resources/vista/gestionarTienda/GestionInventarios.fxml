<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" stylesheets="@../../css/gestionarTienda/estilosCssInventarios.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.GestionInventariosControlador">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestión de Inventarios" />
        <Region HBox.hgrow="ALWAYS" />
        <Label prefHeight="19.0" prefWidth="68.0" styleClass="label-busqueda" text="Buscar:" />
        <TextField fx:id="txtBuscar" prefHeight="36.0" prefWidth="291.0" promptText="Nombre o ID del inventario ..." styleClass="campo-busqueda" />
    </HBox>

    <TableView fx:id="tablaInventarios" prefHeight="450.0" prefWidth="1220.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre del Inventario" />
            <TableColumn fx:id="colCapacidadMax" prefWidth="150.0" text="Capacidad Máxima" />
            <TableColumn fx:id="colCapacidadOcupada" prefWidth="150.0" text="Stock Ocupado" />
            <TableColumn fx:id="colCapacidadLibre" prefWidth="150.0" text="Espacio Libre" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button maxHeight="45.0" mnemonicParsing="false" onAction="#abrirFormularioNuevo" prefHeight="40.0" prefWidth="153.0" styleClass="btn-accion, btn-nuevo" text="Nuevo Inventario" />
        <Button maxHeight="45.0" mnemonicParsing="false" onAction="#abrirFormularioEdicion" prefHeight="40.0" prefWidth="190.0" text="Modificar Seleccionado">
         <styleClass>
            <String fx:value="btn-accion" />
            <String fx:value="button" />
         </styleClass></Button>

        <Region prefHeight="50.0" prefWidth="466.0" HBox.hgrow="ALWAYS" />

        <Button maxHeight="45.0" mnemonicParsing="false" onAction="#editarProductosInventario" prefHeight="40.0" prefWidth="246.0" text="Editar Productos del Inventario">
         <styleClass>
            <String fx:value="btn-accion" />
            <String fx:value="btn-editar" />
         </styleClass></Button>
        <Button maxHeight="45.0" mnemonicParsing="false" onAction="#volverAlPanel" prefHeight="40.0" prefWidth="87.0" styleClass="btn-accion, btn-secundario" text="Volver" />
    </HBox>
</VBox>
