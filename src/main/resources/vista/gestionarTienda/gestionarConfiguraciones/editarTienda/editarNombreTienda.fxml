<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="450.0" spacing="15.0" stylesheets="@../../../../css/gestionarTienda/gestionarConfiguraciones/estilosCssConfiguraciones.css" styleClass="fondo-panel"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarConfiguraciones.editarTienda.EdicionTiendaControlador">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Editar Detalles de la Tienda" />
    <Label style="-fx-text-fill: #666666;" text="Modifica la información general de tu negocio" />

    <VBox spacing="5.0">
        <Label text="Nombre de la Tienda:" />
        <TextField fx:id="txtNombre" promptText="Ej: Supermercado Central" prefHeight="35.0" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Descripción:" />
        <TextArea fx:id="txtDescripcion" prefRowCount="4" promptText="Breve descripción del negocio..." wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
        <Button fx:id="btnCancelar" cancelButton="true" onAction="#cerrarVentana" styleClass="btn-cancelar" text="Cancelar" />
        <Button fx:id="btnGuardar" defaultButton="true" onAction="#guardarCambios" styleClass="btn-guardar" text="Guardar Cambios" />
    </HBox>
</VBox>
