<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="500.0" styleClass="fondo-panel" stylesheets="@../../../../css/gestionarTienda/gestionarConfiguraciones/gestionPermisos/estilosCssEditarDescripcionPermiso.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarConfiguraciones.gestionPermisos.EditarDescripcionPermisoControlador">

    <VBox alignment="CENTER_LEFT" spacing="5.0" styleClass="panel-encabezado">
        <Label styleClass="titulo-principal" text="✏ Editar Permiso" />
        <Label styleClass="subtitulo" text="Modifica la descripción detallada de este permiso" />
    </VBox>

    <VBox spacing="15.0" styleClass="panel-formulario" VBox.vgrow="ALWAYS">

        <VBox spacing="5.0" styleClass="caja-nombre-permiso">
            <Label styleClass="label-formulario" text="Nombre del Permiso:" />
            <Label fx:id="lblNombrePermiso" styleClass="texto-nombre-permiso" text="Cargando permiso ..." wrapText="true" />
        </VBox>

        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
            <Label styleClass="label-formulario" text="Descripción:" />
            <TextArea fx:id="txtDescripcion" prefHeight="120.0" promptText="Escribe aquí los detalles sobre lo que permite hacer este permiso..." styleClass="campo-area-texto" wrapText="true" VBox.vgrow="ALWAYS" />
            <Label styleClass="texto-ayuda" text="* Sé claro y conciso para facilitar la gestión de roles." />
        </VBox>

    </VBox>

    <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="15.0" styleClass="panel-botones">
        <Button fx:id="btnGuardar" defaultButton="true" mnemonicParsing="false" onAction="#guardarCambios" prefHeight="42.0" prefWidth="160.0" styleClass="btn-guardar" text="Guardar Cambios" />
        <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" onAction="#cerrarVentana" prefHeight="42.0" prefWidth="120.0" styleClass="btn-cancelar" text="Cancelar" />
    </HBox>

</VBox>
