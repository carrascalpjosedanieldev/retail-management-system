<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" styleClass="fondo-panel" stylesheets="@../../../../css/gestionarTienda/gestionarConfiguraciones/gestionPermisos/estilosCssPermisosVista.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarConfiguraciones.gestionPermisos.GestionPermisosControlador">

    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>

    <VBox spacing="5.0">
        <Label styleClass="titulo-pantalla" text="Catálogo de Permisos" />
        <Label styleClass="subtitulo-pantalla" text="Consulta los permisos disponibles en el sistema y sus descripciones." />
    </VBox>

    <HBox spacing="20.0">

        <VBox prefHeight="70.0" prefWidth="170.0" spacing="5.0">
            <Label prefHeight="20.0" prefWidth="122.0" styleClass="label-filtro" text="Buscar Permiso:" />
            <TextField fx:id="txtBuscar" prefHeight="42.0" prefWidth="201.0" promptText="Ej: Vender, Crear..." styleClass="campo-filtro" />
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="label-filtro" text="Filtrar por Estado:" />
            <HBox styleClass="toggle-container">
                <fx:define>
                    <ToggleGroup fx:id="tgEstado" />
                </fx:define>
                <ToggleButton fx:id="btnFiltroTodos" prefHeight="38.0" selected="true" styleClass="btn-toggle, btn-toggle-izq" text="Todos" toggleGroup="$tgEstado"/>
                <ToggleButton fx:id="btnFiltroActivos" prefHeight="38.0" styleClass="btn-toggle, btn-toggle-centro" text="Activos" toggleGroup="$tgEstado" />
                <ToggleButton fx:id="btnFiltroInactivos" prefHeight="38.0" styleClass="btn-toggle, btn-toggle-der" text="Inactivos" toggleGroup="$tgEstado" />
            </HBox>
        </VBox>

        <VBox spacing="5.0">
            <Label styleClass="label-filtro" text="Filtrar por Módulo:" />
            <ComboBox fx:id="cbFiltroModulo" prefHeight="42.0" prefWidth="192.0" promptText="Todos los Módulos" styleClass="combo-filtro" />
        </VBox>
      <Button fx:id="btnCambiarDescripcion" mnemonicParsing="false" onAction="#accionCambiarDescripcion" prefHeight="44.0" prefWidth="212.0" text="📝 Cambiar Descripcion">
         <HBox.margin>
            <Insets top="25.0" />
         </HBox.margin>
      </Button>
      <Button fx:id="btnCambiarEstado" mnemonicParsing="false" onAction="#accionCambiarEstado" prefHeight="44.0" prefWidth="206.0" text="🔄 Activar / Desactivar">
         <HBox.margin>
            <Insets top="25.0" />
         </HBox.margin>
      </Button>

        <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#accionSalir" prefHeight="40.0" prefWidth="100.0" styleClass="btn-salir" text="Salir">
            <HBox.margin>
                <Insets top="25.0" />
            </HBox.margin>
        </Button>

    </HBox>

    <TableView fx:id="tablaPermisos" prefHeight="449.0" prefWidth="1219.0" styleClass="tabla-personalizada" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="86.39998853206635" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="291.20008087158203" text="Nombre del Permiso" />
            <TableColumn fx:id="colModulo" prefWidth="200.7999267578125" text="Módulo" />
            <TableColumn fx:id="colDescripcion" prefWidth="475.20001220703125" text="Descripción Detallada" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <placeholder>
            <Label styleClass="placeholder-tabla" text="No hay permisos registrados o no coinciden con los filtros aplicados." />
        </placeholder>
    </TableView>

</VBox>
