<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../../../../css/gestionarTienda/gestionarConfiguraciones/gestionRoles/estilosCssGestionRoles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarConfiguraciones.gestionRoles.GestionRolesControlador">

    <VBox style="-fx-padding: 40; -fx-spacing: 20;" HBox.hgrow="ALWAYS">
        <Label styleClass="titulo-principal" text="Gestión de Roles" />

        <HBox alignment="CENTER_LEFT" style="-fx-spacing: 15;">
            <Label style="-fx-font-size: 18px;" text="🔍" />
            <Label prefHeight="26.0" prefWidth="66.0" styleClass="label-busqueda" text="Buscar:" />
            <TextField fx:id="txtBuscar" prefWidth="400.0" promptText="Buscar por ID o Nombre del rol..." styleClass="campo-busqueda" />
        </HBox>

        <TableView fx:id="tablaRoles" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="NOMBRE DEL ROL" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox alignment="TOP_CENTER" prefWidth="320.0" styleClass="panel-acciones">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-padding: 0 0 20 0;" text="Acciones" />

        <Button fx:id="btnNuevoRol" onAction="#abrirFormularioNuevo" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-nuevo" text="➕ Nuevo Rol" />
        <Button fx:id="btnModificarRol" onAction="#abrirFormularioEdicion" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion" text="✏ Modificar Seleccionado" />
        <Button fx:id="btnAdministrarPermisos" onAction="#administrarPermisosRol" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion" text="🔑 Administrar sus Permisos" />

        <VBox VBox.vgrow="ALWAYS" />

        <Button onAction="#volverAlPanel" prefHeight="50.0" prefWidth="250.0" styleClass="btn-accion, btn-volver" text="⬅ Volver al Panel" />
    </VBox>

</HBox>
