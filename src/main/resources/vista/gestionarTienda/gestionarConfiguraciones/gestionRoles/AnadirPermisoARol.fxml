<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="750.0" spacing="15.0" styleClass="fondo-panel" stylesheets="@../../../../css/gestionarTienda/gestionarConfiguraciones/gestionRoles/estilosCssAnadirPermisoAlRol.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RetailManagementSystem.vista.controladores.gestionarTienda.gestionarConfiguraciones.gestionRoles.AnadirPermisoAlRolControlador">

    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <VBox spacing="5.0">
        <Label styleClass="titulo-pantalla" text="Catálogo de Permisos" />
        <Label styleClass="subtitulo-pantalla" text="Agrega el Permiso que no tenga el Rol seleccionado." />
    </VBox>

    <HBox spacing="15.0">

        <VBox prefHeight="70.0" prefWidth="185.0" spacing="5.0">
            <Label prefHeight="20.0" styleClass="label-filtro" text="Buscar Permiso:" />
            <TextField fx:id="txtBuscar" prefHeight="40.0" prefWidth="250.0" promptText="Ej: Vender, Crear..." styleClass="campo-filtro" />
        </VBox>

        <VBox prefHeight="70.0" prefWidth="193.0" spacing="5.0">
            <Label styleClass="label-filtro" text="Filtrar por Módulo:" />
            <ComboBox fx:id="cbFiltroModulo" prefHeight="46.0" prefWidth="198.0" promptText="Todos los Módulos" styleClass="combo-filtro" />
        </VBox>

        <Button fx:id="btnAnadir" mnemonicParsing="false" onAction="#accionAnadirPermiso" prefHeight="44.0" prefWidth="171.0" styleClass="button" text="➕ Añadir Permiso">
            <HBox.margin>
                <Insets top="25.0" />
            </HBox.margin>
        </Button>

        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#accionCancelar" prefHeight="44.0" prefWidth="114.0" styleClass="btn-cancelar" text="Cancelar">
            <HBox.margin>
                <Insets top="25.0" />
            </HBox.margin>
        </Button>

    </HBox>

    <TableView fx:id="tablaPermisos" prefHeight="350.0" prefWidth="700.0" styleClass="tabla-personalizada" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre del Permiso" />
            <TableColumn fx:id="colModulo" prefWidth="140.0" text="Módulo" />
            <TableColumn fx:id="colDescripcion" prefWidth="230.0" text="Descripción Detallada" />
            <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <placeholder>
            <Label styleClass="placeholder-tabla" text="No hay permisos registrados o no coinciden con los filtros aplicados." />
        </placeholder>
    </TableView>

</VBox>
