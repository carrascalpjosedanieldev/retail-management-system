<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="900.0" spacing="15.0" stylesheets="@../../css/gestionarTienda/estilosCssProductos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.gestionarTienda.TabGeneralProductosControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <HBox>
            <fx:define>
                <ToggleGroup fx:id="grupoFiltroEstado" />
            </fx:define>

            <ToggleButton fx:id="btnFiltroTodos" mnemonicParsing="false" selected="true" styleClass="segment-btn, segment-left" text="Todos" toggleGroup="$grupoFiltroEstado" />
            <ToggleButton fx:id="btnFiltroDisponibles" mnemonicParsing="false" styleClass="segment-btn, segment-center" text="Disponibles" toggleGroup="$grupoFiltroEstado" />
            <ToggleButton fx:id="btnFiltroNoDisponibles" mnemonicParsing="false" styleClass="segment-btn, segment-right" text="No Disponibles" toggleGroup="$grupoFiltroEstado" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label styleClass="label-busqueda" text="Buscar:" />
        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Código o Nombre..." styleClass="campo-busqueda" />
    </HBox>

    <TableView fx:id="tablaProductos" prefHeight="400.0" prefWidth="860.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="256.8000431060791" style="-fx-alignment: CENTER;" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="217.60003662109375" style="-fx-alignment: CENTER;" text="Nombre del Producto" />
            <TableColumn fx:id="colValor" prefWidth="144.00003051757812" style="-fx-alignment: CENTER;" text="Valor Venta" />
            <TableColumn fx:id="colStock" prefWidth="82.39996337890625" style="-fx-alignment: CENTER;" text="Stock" />
            <TableColumn fx:id="colEstado" prefWidth="152.0" style="-fx-alignment: CENTER;" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#abrirSelectorNuevoProducto" prefHeight="31.0" prefWidth="174.0" styleClass="btn-accion, btn-nuevo" text="+ Nuevo Producto" />
      <Button mnemonicParsing="false" onAction="#abrirManejarStock" prefHeight="31.0" prefWidth="178.0" styleClass="btn-accion" text="Manejar Stock" />
      <Button mnemonicParsing="false" onAction="#abrirMoverAOtroInventario" prefHeight="31.0" prefWidth="221.0" styleClass="btn-accion" text="Mover a otro Inventario" />
        <Button mnemonicParsing="false" onAction="#cambiarEstadoProducto" styleClass="btn-accion, btn-secundario" text="Cambiar Estado (Disp / No Disp)" />
    </HBox>
</VBox>

