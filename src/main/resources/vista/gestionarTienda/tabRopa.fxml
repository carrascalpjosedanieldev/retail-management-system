<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="0.0" minWidth="0.0" spacing="15.0" stylesheets="@../../css/gestionarTienda/estilosCssProductos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.TabRopaControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="label-busqueda" text="Buscar Ropa:" />
        <TextField fx:id="txtBuscar" prefWidth="300.0" promptText="Código, Nombre o Talla..." styleClass="campo-busqueda" />
    </HBox>

    <TableView fx:id="tablaRopa" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="250.0" style="-fx-alignment: CENTER;" text="Prenda" />
            <TableColumn fx:id="colTalla" style="-fx-alignment: CENTER;" text="Talla" />
            <TableColumn fx:id="colCompra" prefWidth="120.0" style="-fx-alignment: CENTER;" text="V. Compra" />
            <TableColumn fx:id="colGanancia" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Ganancia" />
            <TableColumn fx:id="colImpuesto" prefWidth="160.0" style="-fx-alignment: CENTER;" text="Impuesto" />
            <TableColumn fx:id="colDescuento" prefWidth="160.0" style="-fx-alignment: CENTER;" text="Descuento" />
            <TableColumn fx:id="colVentaFinal" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Venta Final" />
            <TableColumn fx:id="colStock" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Stock" />
            <TableColumn fx:id="colEstado" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#abrirEditorRopa" styleClass="btn-accion, btn-secundario" text="Editar Prenda de Ropa" />
        <Button mnemonicParsing="false" onAction="#cambiarEstadoProducto" styleClass="btn-accion, btn-secundario" text="Cambiar Estado (Disp / No Disp)" />
    </HBox>
</VBox>
