<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="0.0" minWidth="0.0" spacing="15.0" stylesheets="@../css/estilosCssProductos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.TabPerecederosControlador">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Barra de Búsqueda Superior -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="label-busqueda" text="Buscar Perecedero:" />
        <TextField fx:id="txtBuscar" prefWidth="300.0" promptText="Código o Nombre..." styleClass="campo-busqueda" />
    </HBox>

    <!-- Tabla Principal -->
    <TableView fx:id="tablaPerecederos" VBox.vgrow="ALWAYS">
        <columns>
            <!-- Datos Básicos -->
            <TableColumn fx:id="colCodigo" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Producto" />

            <!-- Datos de Vencimiento -->
            <TableColumn fx:id="colFechaVencimiento" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Vence" />
            <TableColumn fx:id="colPoliticaVencimiento" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Política" />
            <TableColumn fx:id="colEstaVencido" prefWidth="80.0" style="-fx-alignment: CENTER;" text="¿Vencido?" />

            <!-- Valores Financieros -->
            <TableColumn fx:id="colCompra" prefWidth="100.0" style="-fx-alignment: CENTER;" text="V. Compra" />
            <TableColumn fx:id="colGanancia" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Ganancia" />
            <TableColumn fx:id="colImpuesto" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Impuesto" />
            <TableColumn fx:id="colDescuento" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Descuento" />
            <TableColumn fx:id="colVentaFinal" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Venta Final" />

            <!-- Inventario y Estado -->
            <TableColumn fx:id="colStock" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Stock" />
            <TableColumn fx:id="colDisponible" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Botones de Acción Inferiores -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#abrirEditorPerecedero" styleClass="btn-accion, btn-secundario" text="Editar Producto Perecedero" />
        <Button mnemonicParsing="false" onAction="#cambiarEstadoProducto" styleClass="btn-accion, btn-secundario" text="Cambiar Estado (Disp / No Disp)" />
    </HBox>

</VBox>
