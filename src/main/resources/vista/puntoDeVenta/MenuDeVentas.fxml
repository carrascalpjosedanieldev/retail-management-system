<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="fondo-dashboard" stylesheets="@../../css/puntoDeVenta/estilosCssMenuDeVentas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.puntoDeVenta.MenuDeVentasControlador">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="cabecera" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverAlMenu" styleClass="btn-volver" text="⬅ Volver" />
            <Label styleClass="titulo-cabecera" text="Atender Cliente (Nueva Venta)" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="texto-estado" text="Caja 01 - Abierta" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="panel-busqueda">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
                <Label styleClass="label-busqueda" text="Código:" />
                <TextField fx:id="txtCodigo" prefHeight="40.0" prefWidth="250.0" promptText="Escriba el código ..." styleClass="input-codigo" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#agregarItem" prefHeight="40.0" styleClass="btn-secundario" text="Agregar (Enter)" />
            </HBox>

            <TableView fx:id="tablaCarrito" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="285.5999565124512" text="Código" />
                    <TableColumn fx:id="colDescripcion" prefWidth="234.39996337890625" text="Descripción" />
                    <TableColumn fx:id="colCantidad" prefWidth="66.4000244140625" text="Cant." />
                    <TableColumn fx:id="colPrecio" prefWidth="161.5999755859375" text="Precio Unit." />
                    <TableColumn fx:id="colSubtotal" prefWidth="146.4000244140625" text="Subtotal" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="20.0" />
            </padding>
            <VBox spacing="15.0" styleClass="panel-totales">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>
                <Label styleClass="titulo-totales" text="Resumen de Venta" />

                <HBox alignment="CENTER">
                    <Label styleClass="label-detalle" text="Subtotal:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubtotal" styleClass="valor-detalle" text="\$ 0.00" />
                </HBox>

                <HBox alignment="CENTER">
                    <Label styleClass="label-detalle" text="Impuestos:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblImpuestos" styleClass="valor-detalle" text="\$ 0.00" />
                </HBox>

                <VBox prefHeight="1.0" styleClass="separador-totales">
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </VBox>

                <VBox alignment="CENTER">
                    <Label styleClass="label-total-grande" text="Total a Pagar:" />
                    <Label fx:id="lblTotalGeneral" styleClass="valor-total-grande" text="\$ 0.00" />
                </VBox>
            </VBox>

            <VBox spacing="10.0">
                <Label styleClass="label-detalle" text="Modificar Cantidad del Seleccionado:" />

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="btnAumentarCant" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#aumentarCantidadSeleccionada" prefHeight="40.0" styleClass="btn-secundario" text="➕ Aumentar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnReducirCant" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#reducirCantidadSeleccionada" prefHeight="40.0" styleClass="btn-secundario" text="➖ Reducir" HBox.hgrow="ALWAYS" />
                </HBox>

                <Button fx:id="btnEliminarItem" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminarItemSeleccionado" prefHeight="40.0" styleClass="btn-secundario" text="🗑 Eliminar Ítem" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15.0">
                <Button fx:id="btnCancelarVenta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cancelarVenta" prefHeight="50.0" styleClass="btn-cancelar" text="Cancelar Venta" />
                <Button fx:id="btnProcesarVenta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#procesarVenta" prefHeight="70.0" styleClass="btn-procesar" text="Finalizar Compra" />
            </VBox>

        </VBox>
    </right>
</BorderPane>

