<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" style="-fx-background-color: #f8f9fa;" stylesheets="@../css/estilosCssServicios.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.GestionServiciosControlador">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <VBox spacing="5.0">
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Gestión de Servicios" />
        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Administra el catálogo de servicios, sus precios, impuestos y descuentos." />
    </VBox>

    <HBox alignment="CENTER_LEFT" style="-fx-spacing: 15;">
        <Label style="-fx-font-size: 18px;" text="🔍" />
        <Label styleClass="label-busqueda" text="Buscar:" />
        <TextField fx:id="txtBuscar" prefWidth="450.0" promptText="Buscar por Código o Nombre del servicio..." styleClass="campo-busqueda" />
    </HBox>

    <TableView fx:id="tablaServicios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="296.00001525878906" text="CÓDIGO" />
            <TableColumn fx:id="colNombre" prefWidth="212.7999267578125" text="NOMBRE DEL SERVICIO" />
            <TableColumn fx:id="colPrecioBase" prefWidth="134.40008544921875" text="PRECIO BASE" />
            <TableColumn fx:id="colImpuesto" prefWidth="158.39996337890625" text="IMPUESTO APLICADO" />
            <TableColumn fx:id="colDescuento" prefWidth="168.0" text="DESCUENTO APLICADO" />
            <TableColumn fx:id="colPrecioFinal" prefWidth="125.60015869140625" text="PRECIO FINAL" />
            <TableColumn fx:id="colEstado" prefWidth="99.9998779296875" text="ESTADO" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button onAction="#abrirFormularioNuevo" prefHeight="40.0" prefWidth="160.0" style="-fx-cursor: hand;" text="➕ Nuevo Servicio">
         <styleClass>
            <String fx:value="btn-accion" />
            <String fx:value="btn-nuevo" />
         </styleClass></Button>
        <Button onAction="#abrirFormularioEdicion" prefHeight="40.0" prefWidth="219.0" styleClass="btn-accion" text="✏ Modificar Seleccionado" />
        <Button onAction="#cambiarEstadoServicio" prefHeight="40.0" prefWidth="160.0" styleClass="btn-accion" text="🔄 Cambiar Estado" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button onAction="#volverAlPanel" prefHeight="40.0" prefWidth="160.0" text="⬅️ Volver al Panel">
         <styleClass>
            <String fx:value="button" />
            <String fx:value="btn-accion" />
            <String fx:value="btnSalir" />
         </styleClass></Button>
    </HBox>

</VBox>
