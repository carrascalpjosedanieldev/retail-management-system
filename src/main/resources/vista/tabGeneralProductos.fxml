<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoPropio1.vista.controladores.TabGeneralProductosControlador">    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <HBox>
            <fx:define>
                <ToggleGroup fx:id="grupoFiltroEstado" />
            </fx:define>
            <ToggleButton fx:id="btnFiltroTodos" mnemonicParsing="false" selected="true" styleClass="segment-btn, segment-left" text="Todos" toggleGroup="$grupoFiltroEstado" />
            <ToggleButton fx:id="btnFiltroDisponibles" mnemonicParsing="false" styleClass="segment-btn, segment-center" text="Disponibles" toggleGroup="$grupoFiltroEstado" />
            <ToggleButton fx:id="btnFiltroNoDisponibles" mnemonicParsing="false" styleClass="segment-btn, segment-right" text="No Disponibles" toggleGroup="$grupoFiltroEstado" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label styleClass="label-busqueda" text="Buscar:" />
        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Código o Nombre..." styleClass="campo-busqueda" />
    </HBox>

    <TableView fx:id="tablaProductos" prefHeight="400.0" prefWidth="860.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="280.0" text="Nombre del Producto" />
            <TableColumn fx:id="colValor" prefWidth="150.0" text="Valor Venta" />
            <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#abrirSelectorNuevoProducto" styleClass="btn-accion, btn-nuevo" text="+ Nuevo Producto" />
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#cambiarEstadoProducto" styleClass="btn-accion, btn-secundario" text="Cambiar Estado (Disp / No Disp)" />
    </HBox>
</VBox>
